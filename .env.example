# Google Maps API key.
# Satu file ini dipakai Android (Gradle membaca saat build) dan web
# (flutter run --dart-define-from-file=.env).
# Jangan commit nilai asli.
GOOGLE_MAPS_API_KEY=

# Alamat API backend. Kosong = default otomatis:
# web: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Device fisik/iOS simulator: isi URL yang bisa dijangkau, mis. http://192.168.1.10:3000
API_BASE_URL=
