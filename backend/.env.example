# Techy Trashker API — environment variables
# Copy ke .env lalu isi nilainya:
#   cp .env.example .env

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=*
LOG_LEVEL=info
# Set true kalau backend di belakang reverse proxy/platform (Railway, Render,
# Fly, Nginx) agar rate limit memakai IP asli dari X-Forwarded-For.
TRUST_PROXY=false

# ── Supabase Auth ─────────────────────────────────────────────
# Dashboard → Project Settings → API
# Nama baru: SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY
# Nama lama: SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (didukung)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# ── Postgres (Drizzle) ────────────────────────────────────────
# Runtime: connection pooler Supabase (port 6543) + sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Migrasi + seed: direct connection (port 5432)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# ── Domain ────────────────────────────────────────────────────
QR_TTL_SECONDS=300
RATE_LIMIT_MAX=300
